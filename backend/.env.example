# Server
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Data: use Neon/Supabase Postgres in deployment. SQLite is fine for local demo.
DATABASE_URL=sqlite:///omnirep.db

# Chain RPCs
ETH_RPC_URL=https://ethereum-sepolia.publicnode.com
BASE_RPC_URL=https://sepolia.base.org
INDEXER_BLOCK_WINDOW=20000

# Etherscan/Basescan V2 API key is optional but improves wallet-age/gas/tx enrichment.
ETHERSCAN_API_KEY=

# Backend-only attestor key. Never put this into the frontend.
ATTESTOR_PRIVATE_KEY=

# Deployed addresses
OMNIREP_REGISTRY_ADDRESS=
TRAILMARK_REGISTRY_ADDRESS=
OMNIREP_VERIFIER_ADDRESS=
TRAILMARK_VERIFIER_ADDRESS=
OMNIREP_BADGE_ADDRESS=
TRAILMARK_BADGE_ADDRESS=
LENDLITE_ADDRESS=
ETH_LOAN_POOL_ADDRESS=
BASE_LOAN_POOL_ADDRESS=
ETH_GOVERNOR_ADDRESS=
BASE_GOVERNOR_ADDRESS=
ETH_CONTRIBUTION_ADDRESS=
BASE_CONTRIBUTION_ADDRESS=

# Optional bounded AI second opinion for Sybil Radar
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
